# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# Tạo khoá bí mật nhanh: npm run secrets

# --- URL ---
# Địa chỉ người dùng mở web. Dev: http://localhost:5173 · Docker: http://localhost:3000 · Render: https://<ten>.onrender.com
WEB_URL=http://localhost:5173
PORT=3000

# --- Đăng nhập. Email + mật khẩu luôn bật; mỗi nhà cung cấp OAuth chỉ hiện khi điền đủ ID + SECRET ---
# Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Luôn là WEB_URL + /api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback
# Microsoft 365 (https://entra.microsoft.com → App registrations). Callback: WEB_URL/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common = mọi tài khoản Microsoft; hoặc tenant ID của công ty
MICROSOFT_TENANT=common
# GitHub (https://github.com/settings/developers → OAuth Apps). Callback: WEB_URL/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Phiên đăng nhập ---
JWT_SECRET=change-me
JWT_EXPIRES_IN_SECONDS=604800
# Email được kích hoạt ngay với quyền ADMIN (phân tách bằng dấu phẩy)
ADMIN_EMAILS=
# Để trống = mọi tài khoản Google đều đăng nhập được (vẫn phải chờ duyệt)
ALLOWED_EMAIL_DOMAINS=

# --- Database (PostgreSQL) ---
# Dev: khớp infra/docker/docker-compose.dev.yml · Render: chuỗi kết nối Neon + DATABASE_SSL=true
DATABASE_URL=postgres://workspace:workspace@localhost:5432/workspace
DATABASE_SSL=false
# Chỉ dùng cho infra/docker/docker-compose.yml
POSTGRES_USER=workspace
POSTGRES_PASSWORD=workspace
POSTGRES_DB=workspace

# --- Lưu file (chuẩn S3: MinIO khi chạy máy, Cloudflare R2 khi deploy) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=workspace
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=25

# --- Email thông báo (tuỳ chọn, để trống SMTP_HOST = chỉ thông báo trong app) ---
# Gmail: smtp.gmail.com, cổng 587, SMTP_PASS là "App password"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=4SigmaBrains <no-reply@example.com>

# --- Lịch nhắc hạn gọi từ GitHub Actions (header x-cron-secret) ---
CRON_SECRET=

# Phục vụ giao diện từ backend: image Docker đã tự đặt SERVE_STATIC_DIR=/app/public, không cần khai báo.

# --- Tên miền khi bật Caddy HTTPS (infra/docker, profile https) ---
DOMAIN=
