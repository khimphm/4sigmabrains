# Sao chép thành .env rồi điền giá trị thật. Không commit file .env.

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Khi chạy dev (npm run dev). Docker Compose tự đặt lại thành PUBLIC_URL/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# --- Phiên đăng nhập ---
# Tạo bằng: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN_SECONDS=604800

# Email được kích hoạt ngay với quyền ADMIN (phân tách bằng dấu phẩy)
ADMIN_EMAILS=
# Để trống = mọi tài khoản Google đều đăng nhập được (vẫn phải chờ duyệt)
ALLOWED_EMAIL_DOMAINS=

# --- URL ---
WEB_URL=http://localhost:5173
# URL công khai khi chạy bằng Docker Compose
PUBLIC_URL=http://localhost:8080

# --- Hạ tầng (giá trị mặc định khớp docker-compose.yml) ---
POSTGRES_USER=workspace
POSTGRES_PASSWORD=workspace
POSTGRES_DB=workspace
DATABASE_URL=postgres://workspace:workspace@localhost:5432/workspace
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=workspace
